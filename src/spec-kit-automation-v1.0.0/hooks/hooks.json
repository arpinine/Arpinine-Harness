{
  "hooks": {
    "PreToolUse": [
      {
        "description": "Validate constitution before file edits",
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-constitution.sh",
          "timeout": 5
        }]
      }
    ],
    "PostToolUse": [
      {
        "description": "Detect spec-code drift after file writes",
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/quick-drift-check.sh",
          "timeout": 10
        }]
      }
    ]
  }
}
