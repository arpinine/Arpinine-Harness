{
  "hooks": {
    "PreToolUse": [
      {
        "description": "Validate constitution before file edits",
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-constitution.sh",
          "timeout": 5
        }]
      },
      {
        "description": "Block implementation edits until architecture requirements are defined",
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-architecture-readiness.sh",
          "timeout": 5
        }]
      },
      {
        "description": "Block implementation edits unless the current team has an active task claim",
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-task-claim.sh",
          "timeout": 5
        }]
      }
    ],
    "PostToolUse": [
      {
        "description": "Detect lightweight spec drift after file writes, including implementation-time plan updates",
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/quick-drift-check.sh",
          "timeout": 10
        }]
      },
      {
        "description": "Regenerate delivery matrix when task state or other plan.md content is updated",
        "matcher": "Edit|Write",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/update-backlog.sh",
          "timeout": 10
        }]
      }
    ]
  }
}
